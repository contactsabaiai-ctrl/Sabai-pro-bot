 return f"💰 {t} -> 1 SOL = 1,000,000 SABAI\nถาม /tokenomics /farm /locks ได้เลย"
async def start(u,c): await u.message.reply_text("Sabai Pro Bot พร้อม 🤖\n/tokenomics\n/farm\n/locks")
async def tok(u,c): await u.message.reply_text(ans("tokenomics"))
async def locks(u,c): await u.message.reply_text(ans("rug"))
async def farm(u,c):
 s=c.args[0] if c.args else "1"
 await u.message.reply_text(ans(f"{s} sol"))
