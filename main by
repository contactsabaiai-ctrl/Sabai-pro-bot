 if not u.message.text.startswith("/"): await u.message.reply_text(ans(u.message.text))
def main():
 a=Application.builder().token(BOT_TOKEN).build()
 a.add_handler(CommandHandler("start",start))
 a.add_handler(CommandHandler("tokenomics",tok))
 a.add_handler(CommandHandler("locks",locks))
 a.add_handler(CommandHandler("farm",farm))
 a.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND,chat))
 a.run_polling()
if __name__=="__main__": main()
