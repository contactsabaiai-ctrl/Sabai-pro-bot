from telegram.ext import Application, CommandHandler, MessageHandler, filters
BOT_TOKEN="8655226691:AAE2Rl8e_DFDM1LKGRpOpmR2316x1J9ofPk"
def ans(t):
 t=t.lower()
 if "token" in t: return "📊 1B SABAI\n40% LP 400M ล็อค 07 Oct 2027\n30% Staking 300M 1SOL=1M\n15% Marketing 150M ล็อค 07 Dec 2028\n10% Team 100M\n5% Treasury 50M"
